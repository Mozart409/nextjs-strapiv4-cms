{
  "scripts": {
    "dev:backend": "pnpm run --filter backend dev",
    "dev:frontend": "pnpm run --filter frontend dev",
    "be": "pnpm run --filter backend build",
    "fe": "pnpm run --filter frontend dev",
    "seed": "pnpm run --filter backend seed",
    "seed:legacy": "cd apps/backend && pnpm run strapi import -f ../seed-data.tar.gz",
    "export": "cd apps/backend && pnpm run strapi export --no-encrypt -f ../seed-data",
    "build:backend": "podman build -t nextjs-strapiv4-cms/backend -f apps/backend/Dockerfile .",
    "scan:backend": "pnpm run build:backend && trivy image --exit-code 1 --severity HIGH,CRITICAL nextjs-strapiv4-cms/backend && kics scan -p apps/backend/Dockerfile --no-progress --fail-on critical",
    "up": "podman compose up -d",
    "down": "podman compose down",
    "fmt": "dprint fmt 'apps/backend/**/*.{ts,tsx,js,jsx,json}'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0"
  },
  "packageManager": "pnpm@10.29.2",
  "pnpm": {
    "overrides": {
      "shell-quote": "^1.8.4",
      "tar": "^7.5.8",
      "lodash": "^4.18.1",
      "lodash-es": "^4.18.1",
      "minimatch": "^10.2.3",
      "path-to-regexp": "^0.1.13",
      "picomatch": "^4.0.4",
      "fast-uri": "^3.1.2",
      "form-data": "^4.0.6",
      "undici": "^6.27.0",
      "vite": "^6.4.3",
      "ws": "^8.21.0",
      "tmp": "^0.2.6",
      "nodemailer": "^9.0.1",
      "axios": "^1.16.0",
      "follow-redirects": "^1.16.0",
      "brace-expansion": "^5.0.6",
      "yaml": "^1.10.3"
    }
  }
}
